      "properties": {
        "to": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recipient email addresses, e.g. [\"alex@example.com\"]. At least one."
        },
        "cc": {
          "description": "Optional CC addresses.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bcc": {
          "description": "Optional BCC addresses.",
          "type": "array",
          "items": {
            "type": "string"
          }
